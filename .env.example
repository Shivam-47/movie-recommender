# Google AI Studio API key, used for gemini-embedding-001 (https://aistudio.google.com/apikey)
GOOGLE_AI_API_KEY=

# PostgreSQL with the pgvector extension (matches postgres-docker-compose.yaml)
POSTGRESQL_CONNECTION_STRING=postgres://postgres:postgres@localhost:5432/movie-recommender

# Redis Stack (matches redis-docker-compose.yaml; leave the password empty for the local container)
REDIS_HOST_PORT=localhost:6379
REDIS_PASSWORD=
